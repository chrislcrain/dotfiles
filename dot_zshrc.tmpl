# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

{{- if eq .chezmoi.username "coder" }}
export LANG=C.UTF-8

# Keep a stable SSH agent socket so the persistent `main` tmux session
# survives reconnects. Each new SSH connection gets a fresh forwarded
# socket (/tmp/ssh-*/agent.*); the long-lived tmux panes still point at
# the previous, now-dead one, so `ssh-add -l` reports no keys. Re-point a
# fixed symlink at the live socket on every connect and have all shells
# resolve through it.
if [[ -n "$SSH_AUTH_SOCK" && -S "$SSH_AUTH_SOCK" \
      && "$SSH_AUTH_SOCK" != "$HOME/.ssh/ssh_auth_sock" ]]; then
  mkdir -p "$HOME/.ssh"
  ln -sf "$SSH_AUTH_SOCK" "$HOME/.ssh/ssh_auth_sock"
fi
if [[ -L "$HOME/.ssh/ssh_auth_sock" ]]; then
  export SSH_AUTH_SOCK="$HOME/.ssh/ssh_auth_sock"
fi
{{- end }}

DISABLE_AUTO_UPDATE="true"
ZSH_THEME="powerlevel10k/powerlevel10k"
export EDITOR="nvim"
if [[ -n "$NVIM" ]]; then
  export KEYTIMEOUT=50
else
  export KEYTIMEOUT=10
fi

plugins=(
  git
  poetry
  zsh-autosuggestions
  zsh-completions
  direnv
)

source $HOME/.profile
source $ZSH/oh-my-zsh.sh

# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
[[ ! -f "$HOME/.p10k.zsh" ]] || source "$HOME/.p10k.zsh"

# Setup fuzzyfinder
export FZF_SHELL_PATH="$XDG_CONFIG_HOME/fzf/shell"
source "$FZF_SHELL_PATH/completion.zsh"
source "$FZF_SHELL_PATH/key-bindings.zsh"

# Setup  pyenv
if command -v pyenv 1>/dev/null 2>&1; then
  eval "$(pyenv init -)"
fi

export PATH="$PATH:$HOME/.local/bin"
# OpenBao (cc-live). Auth is handled by the bao agent launchd job; this is just the address.
export BAO_ADDR=https://bao.tail5d7bcc.ts.net

# Go toolchain + `go install` binaries (e.g. sedge)
export PATH="$PATH:$HOME/.local/go/bin:$HOME/go/bin"

{{- if eq .chezmoi.username "coder" }}
# Must be the config *file*, not its directory — herdr reads this path
# directly and falls back to built-in defaults if it isn't a readable file.
export HERDR_CONFIG_PATH=/code/.herdr/config.toml
export PATH="/code/bin:$PATH"
export AWS_VAULT_BACKEND=file
export AWS_VAULT_FILE_DIR=/code/.awsvault/keys
export AWS_CONFIG_FILE=/code/.aws/config
[ -f /code/.awsvault/passphrase ] && export AWS_VAULT_FILE_PASSPHRASE="$(cat /code/.awsvault/passphrase)"
{{- end }}

export CODER_SSH_FORWARD_AGENT=TRUE

source $XDG_CONFIG_HOME/ohmyzsh/.zsh_custom/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh

{{ if eq .chezmoi.os "darwin" -}}
export SSH_AUTH_SOCK=$HOME/Library/Group\ Containers/2BUA8C4S2C.com.1password/t/agent.sock
export PATH="$PATH:/Library/PostgreSQL/17/bin"
export PATH="$PATH:/Applications/WezTerm.app/Contents/MacOS"
export PATH="$PATH:$HOME/.config/lua/lua-5.1/src"
export PATH="$PATH:$HOME/.local/share/nvim/mason/bin"
{{- end }}

# direnv hook into shell (not necessary because it is a core plugin)
eval "$(direnv hook zsh)"
