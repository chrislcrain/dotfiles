{{- if eq .chezmoi.username "coder" -}}
#!/bin/bash
# Write herdr's config to $HERDR_CONFIG_PATH (/code/.herdr) so it survives Coder
# workspace rebuilds. /code is outside $HOME, so chezmoi can't manage the file
# directly; this run_onchange script re-applies it whenever the contents change.
set -euo pipefail

HERDR_CONFIG_PATH="${HERDR_CONFIG_PATH:-/code/.herdr/}"
mkdir -p "$HERDR_CONFIG_PATH"

cat > "${HERDR_CONFIG_PATH%/}/config.toml" <<'EOF'
[keys]
# tmux owns C-Space as its prefix and unbinds C-b, so herdr keeping the default
# C-b prefix means the two multiplexers never fight over a prefix.
prefix = "ctrl+b"

# Mirror the vim-tmux-navigator muscle memory: bare Ctrl+h/j/k/l navigate
# panes, but Vim-aware via the vim-herdr-navigation plugin — inside Vim the key
# is forwarded so Vim moves between its own splits first, crossing into herdr
# panes only at an edge. ~/.tmux.conf detects the herdr pane and forwards these
# keys (instead of switching tmux panes) via the is_vim_or_herdr guard.

[[keys.command]]
key = "ctrl+h"
type = "plugin_action"
command = "vim-herdr-navigation.left"
description = "navigate left (vim/herdr)"

[[keys.command]]
key = "ctrl+j"
type = "plugin_action"
command = "vim-herdr-navigation.down"
description = "navigate down (vim/herdr)"

[[keys.command]]
key = "ctrl+k"
type = "plugin_action"
command = "vim-herdr-navigation.up"
description = "navigate up (vim/herdr)"

[[keys.command]]
key = "ctrl+l"
type = "plugin_action"
command = "vim-herdr-navigation.right"
description = "navigate right (vim/herdr)"
EOF

# Plugins live under ~/.config/herdr, which does not survive workspace
# rebuilds — reinstall if missing.
if command -v herdr >/dev/null && ! herdr plugin list --json 2>/dev/null | grep -q '"plugin_id":"vim-herdr-navigation"'; then
  herdr plugin install paulbkim-dev/vim-herdr-navigation --yes
fi
{{- end -}}
